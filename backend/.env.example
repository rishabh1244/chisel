# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Server
PORT=3000
# HOST=0.0.0.0

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/chisel_backend?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# OpenRouter (blueprint AI conversion)
OPENROUTER_API_KEY=sk-or-v1-your_key
# Optional: comma-separated model list. Defaults to a set of free models.
# OPENROUTER_MODEL=model-1,model-2

# CORS: comma-separated list of origins allowed to call the API (defaults to all)
# CORS_ORIGIN=http://localhost:5173,https://yourfrontend.com